# Kelly Online configuration — copy to .env and adjust. Never commit .env.

# Server
PORT=3000
BASE_URL=http://localhost:3000

# Main administration account (seeded on first run, cannot be demoted)
ADMIN_EMAIL=mapadocrew@gmail.com
# Initial password for the seeded admin. If unset, a one-time password is
# generated and printed to the server console on first run.
ADMIN_INITIAL_PASSWORD=

# Data locations (created automatically)
DATA_DIR=./data

# AI provider (OpenAI): the API key and model are configured in the Admin
# area (Settings), not here. Until an admin saves a key, AI intake is off.

# Email. "mailbox" stores outbound mail in the dev mailbox (Admin area).
MAIL_MODE=mailbox
